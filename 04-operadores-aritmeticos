// Os operadores aritméticos são usados para realizar operações matemáticas, como somar, subtrair, multiplicar e dividir valores.

const preco = 50;
const frete = 15;

// Adição (+)
// Serve para somar valores
console.log(preco + frete);

console.log("-------------------")

// 2 - Subtração (-)
// Serve para subtrair um valor do outro
console.log(preco - frete);
console.log(preco - (-frete));

console.log("-------------------")

// 3 - Multiplicação (*)
// SErve para multiplicar dois valores ou mais
console.log(preco * frete);
console.log(preco * (-frete));

console.log("-------------------")

// 4 - Divisão
// Serve para dividir um valor por outro
console.log(preco/ frete);
console.log(preco / (-frete));
console.log((-preco)/ frete);

console.log(0/10);
console.log(10/0);

// 5 - Resto da Divisão (%)
//O operador de resto retorna a sobra da divisão 
console.log(10%3) /* Número ímpar, pois o resto é diferente de zero; */
console.log(11%3) /* Número ímpar, pois o resto é diferente de zero; */
console.log(12%3) /* Número par, pois o resto é zero; */

// 6 - Operador Exponenciação (**)
// Eleva um número a uma potencia, ou seja, é uma forma simplificada de falar que um número é multiplicado por si mesmo x vezes
console.log(preco ** frete)
console.log(2*2*2*2*2*2*2)

// 7 - Operador de Incremento (++)
// Esse operador serve para aumentar em uma unidade o valor de uma variável.

let x = 1;
console.log(x)

x++
console.log(x)

x++
console.log(x)

// 8 - Operador de Decremento (--)
// Esse operador serve para diminuir em uma unidade o valor de uma variável.(-1)
console.log(x--);
console.log(x--);
console.log(x--);
console.log(x--);
console.log(x--);
console.log(x--);